{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://justinahiggins614-cmyk.github.io/signature-ai-olypics/schemas/criteria.schema.json",
  "title": "JAH-OLY Rubric (Criteria)",
  "description": "Judging rubric. Dimension weights MUST sum to 1.0. Rubrics are versioned; history is preserved.",
  "type": "object",
  "required": [
    "id",
    "key",
    "name",
    "dims",
    "version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^JAH-OLY-CRIT-\\d{2}$"
    },
    "key": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "desc": {
      "type": "string"
    },
    "dims": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": [
          {
            "type": "string"
          },
          {
            "type": "number"
          }
        ]
      },
      "description": "[dimension name, weight] pairs; weights sum to 1.0"
    },
    "version": {
      "type": "string"
    }
  }
}